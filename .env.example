# ===================================================
# LA MEGA TIENDA DEL COLCHÓN - VARIABLES DE ENTORNO
# ===================================================

# 1. Base de Datos (MongoDB Atlas - M0 Free Tier)
# Regístrate en https://cloud.mongodb.com -> Crear Cluster M0 -> Conectar con Drivers -> Copiar URI
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/colchon-db?retryWrites=true&w=majority

# 2. Autenticación y Seguridad (NextAuth)
# Genera un hash aleatorio o usa una clave larga y segura
AUTH_SECRET=4faf441129d49fc8a498531230b7570ec12a2d0bb168301753b0735fdb02a610
NEXTAUTH_SECRET=super_secret_random_string_colchon_1234567890_mega
NEXTAUTH_URL=https://lamegatiendadelcolchon.com
NEXT_PUBLIC_SITE_URL=https://lamegatiendadelcolchon.com

# 3. Correos Administrativos (separados por coma)
ADMIN_EMAILS=lamegatiendadelcolchon@gmail.com

# 4. Google OAuth (Opcional - Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 5. ImageKit.io (Almacenamiento y Optimización de Imágenes de Colchones)
# Regístrate en https://imagekit.io -> Developer Options -> API Keys
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=

# 6. Chatbot IA - Google AI Studio (Gemini API - Gratis)
# Obtén tu key en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 7. Optimización de build
NEXT_TELEMETRY_DISABLED=1
